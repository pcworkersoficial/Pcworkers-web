# ========== Servidor ==========
PORT=3000

# ========== OpenAI ==========
OPENAI_API_KEY=sk-...
# Modelo de chat (barato y rápido). Podés cambiarlo por otro de tu cuenta.
OPENAI_MODEL=gpt-4o-mini
# Modelo para transcribir audios de WhatsApp
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ========== WhatsApp Cloud API (Meta) ==========
# developers.facebook.com > Tu app > WhatsApp > Configuración de la API
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Texto que inventás vos; tiene que coincidir con el que pongas en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=pcworkers-verifica-123
# Tu app > Configuración > Básica > Clave secreta de la app (para validar que los mensajes vienen de Meta)
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# ========== Pcworkers ==========
# Tu celular PERSONAL (no el del bot): recibe los avisos de casos y puede usar comandos (#ayuda). Sin "+" ni espacios.
ADMIN_PHONE=5491100000000
# Minutos que el bot queda en silencio con un cliente después de derivarlo a un humano
HANDOFF_MINUTES=120
# Segundos que espera para juntar varios mensajes seguidos del cliente antes de responder
MESSAGE_BATCH_SECONDS=4
